<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_template_view_form_ngsign" model="ir.ui.view">
        <field name="name">sale.order.template.form.ngsign</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Electronic signature (NGSign)" name="ngsign_position">
                    <field name="ngsign_choose_position"/>
                    <field name="ngsign_sig_page" invisible="ngsign_choose_position"/>
                    <field name="ngsign_sig_x" invisible="ngsign_choose_position"/>
                    <field name="ngsign_sig_y" invisible="ngsign_choose_position"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
